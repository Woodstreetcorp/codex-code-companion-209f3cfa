# ─── Borrower Frontend — Environment Variables ────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it is listed in .gitignore.
#
# All VITE_ variables are embedded into the compiled JS bundle at build time.
# Do not put secrets in VITE_ variables.

# ─── API base URL ─────────────────────────────────────────────────────────────
#
# Same-origin deployment (recommended — Nginx proxies /v2/* to Laravel):
#   Leave blank. All fetch calls use relative paths. No CORS required.
#
# Cross-origin deployment (SPA served from a different origin than the API):
#   Set to the full API origin, e.g. https://api.approvu.ca
#   The Laravel backend must have:
#     - FRONTEND_URL set to the SPA origin
#     - supports_credentials=true in config/cors.php
#     - SESSION_SAME_SITE=none and SESSION_SECURE_COOKIE=true (HTTPS only)
#
VITE_APPROVU_API_BASE_URL=

# ─── Google Maps ──────────────────────────────────────────────────────────────
#
# Required for address-autocomplete fields in the qualification flows.
# Obtain a key from https://console.cloud.google.com/
# Restrict the key to the Maps JavaScript API and your production domain.
#
VITE_GOOGLE_MAPS_API_KEY=
