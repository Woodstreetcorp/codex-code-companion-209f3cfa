# Borrower Frontend - Environment Variables
#
# Copy this file to .env or configure these values in the staging host.
# Never commit real .env files.
#
# All VITE_ variables are embedded into the compiled JavaScript bundle at build time.
# Do not put secrets in VITE_ variables.

# API base URL
#
# Same-origin deployment:
# Leave blank. Fetch calls use relative /v2 paths, and no browser CORS is required.
#
# Cross-origin staging deployment:
# Set to the full Laravel API origin, for example https://api-staging.example.com.
# The Laravel backend must allow the exact frontend origin and support credentialed requests.
#
VITE_APPROVU_API_BASE_URL=

# Google Maps
#
# Required for address-autocomplete fields in the qualification flows.
# Restrict this key by HTTP referrer and enable only the required Maps JavaScript / Places APIs.
#
VITE_GOOGLE_MAPS_API_KEY=
